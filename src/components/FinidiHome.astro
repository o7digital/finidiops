</footer>

<script>
  const locale = document.documentElement.lang as 'en' | 'es' | 'fr';
  const set = (selector: string, value: string) => {
    const el = document.querySelector<HTMLElement>(selector);
    if (el) el.textContent = value;
  };
  document.querySelectorAll('.menu button').forEach(x=>x.addEventListener('click',()=>{
    document.querySelectorAll('.menu button').forEach(y=>y.classList.remove('active'));
    x.classList.add('active');
    const label = x.textContent?.replace(/^[^\p{L}]+/u,'').trim();
    if (label) set('.main-top h4', label);
    const moduleCopy = locale === 'es' ? 'Módulo demo interactivo · Datos ilustrativos' : locale === 'fr' ? 'Module de démonstration interactif · Données illustratives' : 'Interactive demo module · Illustrative data';
    set('#viewMeta', moduleCopy);
  }));

  const entityData = {
    group:{values:['$8.42M','18.7%','7.4 mo','$1.18M'],deltas:['▲ 11.2% vs plan','▲ 2.1 pts','▼ 0.8 mo','▲ 6.4%'],bars:[45,54,49,68,63,74,82,88]},
    sandiego:{values:['$4.10M','16.2%','5.8 mo','$740K'],deltas:['▲ 8.4% vs plan','▼ 0.6 pts','▼ 1.1 mo','▲ 3.2%'],bars:[72,65,58,53,49,62,57,69]},
    california:{values:['$4.32M','21.4%','11.2 mo','$440K'],deltas:['▲ 14.8% vs plan','▲ 3.4 pts','▲ 1.6 mo','▲ 9.1%'],bars:[38,44,52,57,63,71,78,86]}
  };
  const entitySelect = document.querySelector<HTMLSelectElement>('#entitySelect');
  entitySelect?.addEventListener('change',()=>{
    const data = entityData[entitySelect.value as keyof typeof entityData];
    ['revenue','margin','runway','capital'].forEach((key,index)=>{
      const value = key === 'runway' ? data.values[index].replace('mo', locale === 'es' ? 'meses' : locale === 'fr' ? 'mois' : 'mo') : data.values[index];
      const delta = data.deltas[index].replace('vs plan', locale === 'fr' ? 'vs budget' : 'vs plan');
      set(`#${key}Value`,value); set(`#${key}Delta`,delta);
    });
    document.querySelectorAll<HTMLElement>('.bar').forEach((bar,index)=>bar.style.height=`${data.bars[index]}%`);
    const selected = entitySelect.options[entitySelect.selectedIndex].text;
    set('#viewMeta',`${selected} · ${locale==='es'?'Vista demo actualizada':locale==='fr'?'Vue démo actualisée':'Updated demo view'}`);
  });

  document.getElementById('aiAsk')?.addEventListener('click',async()=>{
    const input = document.querySelector<HTMLInputElement>('#aiPrompt');
    const button = document.querySelector<HTMLButtonElement>('#aiAsk');
    const message = input?.value.trim();
    if (!message || !button) return;
    const thinking = locale === 'es' ? 'Olivia está analizando tu pregunta…' : locale === 'fr' ? 'Olivia analyse votre question…' : 'Olivia is analyzing your question…';
    const answerLabel = locale === 'es' ? 'Respuesta de Olivia' : locale === 'fr' ? 'Réponse d’Olivia' : 'Olivia’s answer';
    const error = locale === 'es' ? 'Olivia no está disponible en este momento. Escríbele a alejandro@finidicfo.com.' : locale === 'fr' ? 'Olivia est momentanément indisponible. Écrivez à alejandro@finidicfo.com.' : 'Olivia is unavailable right now. Please email alejandro@finidicfo.com.';
    button.disabled = true; set('#briefTitle',thinking); set('#briefCopy','');
    try {
      const response = await fetch('/api/olivia',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message,language:locale,metadata:{pageUrl:location.href,pageTitle:document.title}})});
      if (!response.ok) throw new Error('olivia_unavailable');
      const data = await response.json() as { reply?: string };
      set('#briefTitle',answerLabel); set('#briefCopy',data.reply || error);
    } catch (_error) {
      set('#briefTitle',answerLabel); set('#briefCopy',error);
    } finally {
      button.disabled = false;
    }
  });
</script>
</body>
</html>
