    document.querySelectorAll<HTMLElement>('.bar').forEach((bar,index)=>bar.style.height=`${data.bars[index]}%`);
    const selected = entitySelect.options[entitySelect.selectedIndex].text;
    set('#viewMeta',`${selected} · ${locale==='es'?'Vista demo actualizada':locale==='fr'?'Vue démo actualisée':'Updated demo view'}`);
  });

  document.getElementById('aiAsk')?.addEventListener('click',()=>{
    const answer = locale === 'es'
      ? ['Tres decisiones para la dirección','Acelerar el cobro de cuatro cuentas vencidas, validar el impacto de fletes en el margen Oeste y confirmar el presupuesto de expansión en Canadá. Impacto de liquidez estimado: $186K.']
      : locale === 'fr'
        ? ['Trois décisions pour la direction','Accélérer le recouvrement de quatre comptes en retard, valider l’impact du fret sur la marge Ouest et confirmer le budget d’expansion au Canada. Impact de liquidité estimé : 186 K$.']
        : ['Three decisions for leadership','Accelerate collection on four overdue accounts, validate the West freight margin impact, and confirm the Canada expansion budget. Estimated liquidity impact: $186K.'];
    set('#briefTitle',answer[0]); set('#briefCopy',answer[1]);
  });
</script>
</body>
</html>
