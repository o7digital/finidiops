  const set = (selector: string, value: string, html = false) => {
    const el = document.querySelector<HTMLElement>(selector);
    if (el) html ? el.innerHTML = value : el.textContent = value;
  };
  const setAll = (selector: string, values: readonly string[]) => document.querySelectorAll<HTMLElement>(selector).forEach((el, index) => {
    if (values[index]) el.textContent = values[index];
  });

  if (locale !== 'en') {
    const t = translations[locale];
    setAll('nav > a', t.nav); set('.hero .eyebrow',t.hero[0]); set('.hero h1',t.hero[1],true); set('.hero .sub',t.hero[2]);
    set('#roadmapBtn',t.hero[3]); set('#exploreOsBtn',t.hero[4]); set('.hc-label',t.hero[5]); set('.live',t.hero[6]); set('.hc-note',t.hero[7]);
    setAll('.stats .stat span',t.stats); set('#services .eyebrow',t.section[0]); set('#services h2',t.section[1],true); set('#services .section-head > p',t.section[2]);
    document.querySelectorAll<HTMLElement>('.service').forEach((el,index)=>{const s=t.services[index]; if(!s)return; const q=(x:string)=>el.querySelector<HTMLElement>(x); if(q('.num'))q('.num')!.textContent=s[0]; if(q('h3'))q('h3')!.textContent=s[1]; if(q('p'))q('p')!.textContent=s[2]; if(q('.more'))q('.more')!.textContent=index===5?t.platform:t.explore;});
    set('#markets .eyebrow',t.global[0]); set('#markets h2',t.global[1]); set('#markets .global-copy > p',t.global[2]); setAll('.market span',t.market);
    set('.os-intro .eyebrow',t.os[0]);set('.os-intro h2',t.os[1]);set('.os-intro p',t.os[2]);setAll('.menu button',t.menu);
    set('.main-top h4',t.dashboard[0]);set('#viewMeta',t.dashboard[1]);setAll('.kpi small',t.dashboard.slice(2,6));setAll('.charts .panel-head b',t.dashboard.slice(6,9));setAll('.charts .panel-head span',t.dashboard.slice(7,10));
    setAll('.riskrow > span:first-child',t.dashboard.slice(10,14));setAll('.riskrow .tag',t.dashboard.slice(14,18));
    set('.aihead b',t.ai[0]);set('.ai-badge',t.ai[1]);set('.brief small',t.ai[2]);set('#briefTitle',t.ai[3]);set('#briefCopy',t.ai[4]);const prompt=document.querySelector<HTMLInputElement>('#aiPrompt');if(prompt)prompt.value=t.ai[5];
    set('#approach .eyebrow',t.outcome[0] as string);set('#approach h2',t.outcome[1] as string);set('#approach .section-head > p',t.outcome[2] as string);
    document.querySelectorAll<HTMLElement>('.arch').forEach((el,index)=>{const a=t.outcome[index+3] as readonly string[]; el.querySelector('small')!.textContent=a[0];el.querySelector('h3')!.textContent=a[1];el.querySelector('p')!.textContent=a[2];});
    setAll('.mode-tabs button',t.modes);set('.footer .wrap div:last-child',t.footer);
  }
  const osBtn = document.getElementById('osBtn');
  const siteBtn = document.getElementById('siteBtn');

  const showOS = () => {
    osBtn?.classList.add('active');
    siteBtn?.classList.remove('active');
    scrollTo('platform');
  };
  const showSite = () => {
    siteBtn?.classList.add('active');
    osBtn?.classList.remove('active');
    scrollTo('top');
  };

  osBtn?.addEventListener('click', showOS);
  siteBtn?.addEventListener('click', showSite);
  document.getElementById('roadmapBtn')?.addEventListener('click', () => scrollTo('contact'));
  document.querySelectorAll('.menu button').forEach(x=>x.addEventListener('click',()=>{
    document.querySelectorAll('.menu button').forEach(y=>y.classList.remove('active'));
    x.classList.add('active');
    const label = x.textContent?.replace(/^[^\p{L}]+/u,'').trim();
    if (label) set('.main-top h4', label);
    const moduleCopy = locale === 'es' ? 'Módulo demo interactivo · Datos ilustrativos' : locale === 'fr' ? 'Module de démonstration interactif · Données illustratives' : 'Interactive demo module · Illustrative data';
    set('#viewMeta', moduleCopy);
  }));

  const entityData = {
    group:{values:['$8.42M','18.7%','7.4 mo','$1.18M'],deltas:['▲ 11.2% vs plan','▲ 2.1 pts','▼ 0.8 mo','▲ 6.4%'],bars:[45,54,49,68,63,74,82,88]},
    mexico:{values:['MX$71.6M','16.2%','5.8 mo','MX$14.9M'],deltas:['▲ 8.4% vs plan','▼ 0.6 pts','▼ 1.1 mo','▲ 3.2%'],bars:[72,65,58,53,49,62,57,69]},
    canada:{values:['CA$2.31M','21.4%','11.2 mo','CA$640K'],deltas:['▲ 14.8% vs plan','▲ 3.4 pts','▲ 1.6 mo','▲ 9.1%'],bars:[38,44,52,57,63,71,78,86]}
  };
  const entityNames = {
    en:['Northstar Group · Consolidated','Northstar Mexico · MXN','Northstar Canada · CAD'],
    es:['Grupo Northstar · Consolidado','Northstar México · MXN','Northstar Canadá · CAD'],
    fr:['Groupe Northstar · Consolidé','Northstar Mexique · MXN','Northstar Canada · CAD']
  } as const;
  const entitySelect = document.querySelector<HTMLSelectElement>('#entitySelect');
  entitySelect?.querySelectorAll('option').forEach((option,index)=>option.textContent=entityNames[locale][index]);
  entitySelect?.addEventListener('change',()=>{
    const data = entityData[entitySelect.value as keyof typeof entityData];
    ['revenue','margin','runway','capital'].forEach((key,index)=>{
      set(`#${key}Value`,data.values[index]); set(`#${key}Delta`,data.deltas[index]);
    });
    document.querySelectorAll<HTMLElement>('.bar').forEach((bar,index)=>bar.style.height=`${data.bars[index]}%`);
    const selected = entitySelect.options[entitySelect.selectedIndex].text;
    set('#viewMeta',`${selected} · ${locale==='es'?'Vista demo actualizada':locale==='fr'?'Vue démo actualisée':'Updated demo view'}`);
  });

  document.getElementById('aiAsk')?.addEventListener('click',()=>{
    const answer = locale === 'es'
      ? ['Tres decisiones para la dirección','Acelerar el cobro de cuatro cuentas vencidas, validar el impacto de fletes en el margen Oeste y confirmar el presupuesto de expansión en Canadá. Impacto de liquidez estimado: $186K.']
      : locale === 'fr'
        ? ['Trois décisions pour la direction','Accélérer le recouvrement de quatre comptes en retard, valider l’impact du fret sur la marge Ouest et confirmer le budget d’expansion au Canada. Impact de liquidité estimé : 186 K$.']
        : ['Three decisions for leadership','Accelerate collection on four overdue accounts, validate the West freight margin impact, and confirm the Canada expansion budget. Estimated liquidity impact: $186K.'];
    set('#briefTitle',answer[0]); set('#briefCopy',answer[1]);
  });
</script>
