---
const { locale = 'en' } = Astro.props;
---

<div id="finidi-olivia" data-locale={locale}>
  <button class="olivia-launcher" type="button" aria-label="Open Olivia AI">
    <span class="olivia-launcher-mark">O</span>
    <span><strong>Olivia AI</strong><small>{locale === 'es' ? 'Asistente CFO' : 'CFO assistant'}</small></span>
  </button>
</div>

<style is:inline>
  #finidi-olivia{position:fixed;right:24px;bottom:24px;z-index:2147483646;font-family:Inter,Arial,sans-serif;color:#f7f2e8}
  #finidi-olivia *{box-sizing:border-box}
  .olivia-launcher{display:flex;align-items:center;gap:11px;border:1px solid rgba(202,161,91,.62);border-radius:999px;padding:9px 18px 9px 9px;background:linear-gradient(145deg,#17130d,#070707);color:#fff;box-shadow:0 25px 48px -20px rgba(0,0,0,.78),inset 0 1px 0 rgba(255,255,255,.13);cursor:pointer}
  .olivia-launcher-mark{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,#e2bf79,#a87934);color:#111;font-family:"Playfair Display",serif;font-size:24px;font-weight:800;box-shadow:0 0 0 5px rgba(202,161,91,.12)}
  .olivia-launcher strong,.olivia-launcher small{display:block;text-align:left}.olivia-launcher strong{font-size:14px}.olivia-launcher small{margin-top:2px;color:#b9aa91;font-size:11px}
  .olivia-panel{display:flex;width:min(420px,calc(100vw - 28px));height:min(680px,calc(100vh - 105px));flex-direction:column;overflow:hidden;border:1px solid rgba(202,161,91,.5);border-radius:28px;background:linear-gradient(155deg,rgba(24,21,16,.99),rgba(5,5,5,.99));box-shadow:0 52px 90px -30px rgba(0,0,0,.86),0 22px 42px -24px rgba(0,0,0,.75),inset 0 1px 0 rgba(255,255,255,.16);transform:perspective(1200px) translateY(-8px) rotateX(.4deg) rotateY(-.4deg);animation:finidi-float 5.5s ease-in-out infinite}
  .olivia-header{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:19px 20px;border-bottom:1px solid rgba(202,161,91,.28);background:radial-gradient(circle at 15% 0,rgba(202,161,91,.24),transparent 48%),#111}
  .olivia-title{margin:0;color:#d7b46c;font-family:"Playfair Display",serif;font-size:27px}.olivia-status{display:inline-flex;align-items:center;gap:8px;margin-top:6px;padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.08);color:#c9c1b4;font-size:12px}
  .olivia-dot{width:9px;height:9px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.14),0 0 14px rgba(34,197,94,.8);transition:.25s}.olivia-status.inactive .olivia-dot{background:#f59e0b;box-shadow:0 0 0 4px rgba(245,158,11,.14),0 0 14px rgba(245,158,11,.75)}
  .olivia-close{width:40px;height:40px;border:0;border-radius:50%;background:rgba(202,161,91,.17);color:#fff;font-size:25px;cursor:pointer}
  .olivia-messages{flex:1;overflow-y:auto;padding:17px;background:linear-gradient(rgba(202,161,91,.045) 1px,transparent 1px),#090909;background-size:100% 44px}
  .olivia-message{width:fit-content;max-width:88%;margin:0 0 11px;padding:12px 14px;border-radius:17px;font-size:14px;line-height:1.5;white-space:pre-wrap}.olivia-message.assistant{background:rgba(255,255,255,.09);color:#f4ede1}.olivia-message.user{margin-left:auto;background:linear-gradient(135deg,#ddb96f,#a97832);color:#0b0906}.olivia-message.loading{min-width:52px;color:#d7b46c}
  .olivia-compose{display:grid;grid-template-columns:1fr 52px;gap:9px;padding:14px;border-top:1px solid rgba(202,161,91,.2);background:#090909}.olivia-compose input{min-width:0;border:1px solid rgba(202,161,91,.32);border-radius:15px;background:rgba(255,255,255,.07);padding:13px 14px;color:#fff;font:inherit;outline:0}.olivia-compose input:focus{border-color:#d7b46c;box-shadow:0 0 0 3px rgba(202,161,91,.12)}.olivia-compose input::placeholder{color:#8e887e}.olivia-send{border:0;border-radius:15px;background:linear-gradient(135deg,#ddb96f,#a97832);color:#0b0906;font-size:25px;font-weight:900;cursor:pointer}.olivia-send:disabled{cursor:not-allowed;opacity:.5}
  @keyframes finidi-float{0%,100%{transform:perspective(1200px) translateY(-8px) rotateX(.4deg) rotateY(-.4deg)}50%{transform:perspective(1200px) translateY(-14px) rotateX(.65deg) rotateY(-.15deg)}}
  @media(max-width:560px){#finidi-olivia{right:10px;bottom:10px}.olivia-panel{position:fixed;inset:10px 10px 82px;width:auto;height:auto}.olivia-launcher small{display:none}}
  @media(prefers-reduced-motion:reduce){.olivia-panel{animation:none}}
</style>

<script is:inline>
  (() => {
    const root = document.getElementById('finidi-olivia');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const lang = root.dataset.locale === 'es' ? 'es' : 'en';
    const text = lang === 'es' ? {
      role:'Asistente financiero FINIDI', online:'En línea', placeholder:'Escribe tu pregunta...', open:'Abrir Olivia AI', close:'Cerrar',
      welcome:'Hola, soy Olivia AI de FINIDI. Puedo orientarte sobre servicios de CFO fraccional, flujo de efectivo, planeación financiera, reportes, estructura de capital y soporte M&A. ¿En qué puedo ayudarte?',
      error:'No pude responder en este momento. Inténtalo de nuevo o escribe a alejandro@finidicfo.com.'
    } : {
      role:'FINIDI financial assistant', online:'Online', placeholder:'Write your question...', open:'Open Olivia AI', close:'Close',
      welcome:'Hello, I’m Olivia AI for FINIDI. I can help with fractional CFO services, cash flow, financial planning, reporting, capital structure and M&A support. How can I help?',
      error:'I could not respond right now. Please try again or email alejandro@finidicfo.com.'
    };
    let open=false, loading=false, inactive=false, idleTimer;
    let messages=[{role:'assistant',content:text.welcome}];
    const escape=(value)=>String(value).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
    const render=()=>{
      root.innerHTML=open?`<section class="olivia-panel" aria-label="Olivia AI"><header class="olivia-header"><div><h2 class="olivia-title">Olivia AI</h2><div class="olivia-status ${inactive?'inactive':''}"><i class="olivia-dot" aria-hidden="true"></i>${escape(text.role)} · ${escape(text.online)}</div></div><button class="olivia-close" type="button" aria-label="${escape(text.close)}">×</button></header><div class="olivia-messages">${messages.map(m=>`<div class="olivia-message ${m.role}">${escape(m.content)}</div>`).join('')}${loading?'<div class="olivia-message assistant loading">•••</div>':''}</div><form class="olivia-compose"><input class="olivia-input" autocomplete="off" placeholder="${escape(text.placeholder)}"><button class="olivia-send" type="submit" ${loading?'disabled':''}>›</button></form></section>`:`<button class="olivia-launcher" type="button" aria-label="${escape(text.open)}"><span class="olivia-launcher-mark">O</span><span><strong>Olivia AI</strong><small>${escape(text.role)}</small></span></button>`;
      root.querySelector('.olivia-launcher')?.addEventListener('click',()=>{open=true;render()});
      root.querySelector('.olivia-close')?.addEventListener('click',()=>{open=false;render()});
      root.querySelector('.olivia-compose')?.addEventListener('submit',send);
      const list=root.querySelector('.olivia-messages');if(list)list.scrollTop=list.scrollHeight;
      if(open)root.querySelector('.olivia-input')?.focus();
    };
    async function send(event){event.preventDefault();const input=root.querySelector('.olivia-input');const message=input?.value.trim();if(!message||loading)return;messages.push({role:'user',content:message});loading=true;render();try{const response=await fetch('https://olivia-ai.o7digital.com/api/olivia/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({clientCode:'finidi',message,language:lang,metadata:{pageUrl:location.href,pageTitle:document.title,source:'website-chat'}})});if(!response.ok)throw new Error('chat');const data=await response.json();messages.push({role:'assistant',content:data.reply||text.error})}catch(_error){messages.push({role:'assistant',content:text.error})}finally{loading=false;render()}}
    const markActive=()=>{inactive=false;root.querySelector('.olivia-status')?.classList.remove('inactive');clearTimeout(idleTimer);idleTimer=setTimeout(()=>{inactive=true;root.querySelector('.olivia-status')?.classList.add('inactive')},45000)};
    ['pointerdown','keydown','scroll','touchstart'].forEach(name=>addEventListener(name,markActive,{passive:true}));markActive();render();
  })();
</script>
